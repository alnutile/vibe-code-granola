# vibecode-granola does NOT read secrets from .env at runtime.
# API keys are stored in the macOS Keychain via the in-app Settings screen,
# so nothing sensitive ever lands in this repo or in a plaintext config file.
#
# This file exists only to document which credentials the app can use and where
# to get them. Copy to `.env` if you want a local scratchpad for keys while
# developing — `.env` is gitignored.

# Chat / notes / suggestions (any OpenAI-compatible chat completions endpoint).
# Pick ONE provider in Settings, or switch between them at any time.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Speech-to-text. Leave blank to use a local server (whisper.cpp, speaches,
# LM Studio) which needs no key at all.
# Uses the same OPENAI_API_KEY above when the STT provider is set to OpenAI.

# Local endpoints the app defaults to when you choose a "local" provider.
# Shown here for reference only — configure them in Settings.
# Ollama            http://localhost:11434/v1
# LM Studio         http://localhost:1234/v1
# whisper.cpp       http://127.0.0.1:8080
# speaches / faster-whisper-server  http://127.0.0.1:8000/v1
